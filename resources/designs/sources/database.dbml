// Gerado a partir do snapshot atual do Entity Framework Core.

Project pim04 {
  database_type: 'PostgreSQL'
  Note: 'Esquema da aplicação gerado pelo Entity Framework Core. Tabelas internas do EF Core não estão incluídas.'
}

Table Agendamentos {
  Id uuid [pk]
  ClientRequestId varchar(32) [unique]
  DataAgendamento timestamptz [not null]
  DataConclusao timestamptz
  IdCliente uuid [not null]
  IdFuncionario uuid [not null]
  LastMutationId varchar(32)
  RequestHash text
  Revision bigint [not null]
  Status varchar(9) [not null]
  ValorTotal double

  indexes {
    ClientRequestId [unique]
    IdCliente
    IdFuncionario
  }
}

Table Clientes {
  Id uuid [pk]
  CPF varchar(11) [unique]
  DtNascimento date
  Email text
  Nome text [not null]
  Telefone varchar(13)

  indexes {
    CPF [unique]
  }
}

Table Funcionarios {
  Id uuid [pk]
  CPF varchar(11) [unique]
  Email text [unique]
  Endereco text
  IsDeleted boolean [not null]
  Nome text [not null]
  Telefone varchar(13)

  indexes {
    CPF [unique]
    Email [unique]
  }
}

Table FuncionarioDisponibilidades {
  Id uuid [pk]
  DiaSemana integer [not null]
  Fim time [not null]
  IdFuncionario uuid [not null]
  Inicio time [not null]

  indexes {
    (IdFuncionario, DiaSemana)
  }
}

Table RefreshSessions {
  Jti uuid [pk]
  EmployeeId uuid [not null]
  ExpiresAt timestamptz [not null]

  indexes {
    EmployeeId
  }
}

Table ServicePriceChanges {
  Id bigint [pk]
  ChangedAt timestamptz [not null]
  NewPrice double [not null]
  OldPrice double [not null]
  ServiceId uuid
  ServiceName text [not null]

  indexes {
    ServiceId
  }
}

Table Servicos {
  Id uuid [pk]
  Ativo boolean [not null]
  Descricao text
  Nome text [not null]
  Preco double [not null]

  indexes {
    Nome [unique]
  }
}

Table ServicosRealizados {
  IdServico uuid [not null]
  IdAgendamento uuid [not null]
  Valor double [not null]

  indexes {
    (IdServico, IdAgendamento) [pk]
    IdAgendamento
  }
}

Table Usuarios {
  IdFuncionario uuid [pk]
  Login text [not null]
  password_expired boolean [not null]
  Senha text [not null]

  indexes {
    Login [unique]
  }
}

Ref agendamento_cliente: Agendamentos.IdCliente > Clientes.Id [delete: restrict]
Ref agendamento_funcionario: Agendamentos.IdFuncionario > Funcionarios.Id [delete: restrict]
Ref disponibilidade_funcionario: FuncionarioDisponibilidades.IdFuncionario > Funcionarios.Id [delete: cascade]
Ref refresh_usuario: RefreshSessions.EmployeeId > Usuarios.IdFuncionario [delete: cascade]
Ref historico_servico: ServicePriceChanges.ServiceId ?> Servicos.Id [delete: set null]
Ref realizado_agendamento: ServicosRealizados.IdAgendamento > Agendamentos.Id [delete: cascade]
Ref realizado_servico: ServicosRealizados.IdServico > Servicos.Id [delete: restrict]
Ref usuario_funcionario: Usuarios.IdFuncionario - Funcionarios.Id [delete: cascade]
