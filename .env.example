#### Configuração Postgres ####
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

#### Configuração Redis ####
REDIS_ARGS=--requirepass SENHA_REDIS

#### Configuração API ####

# Substituir usuário e senha pelos mesmos do POSTGRES_USER e POSTGRES_PASSWORD
DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=postgres;Username=;Password=;Enlist=false

# Substituir senha do Redis para a mesma do REDIS_ARGS
REDIS_CONNECTION_STRING=redis,password=SENHA_REDIS
